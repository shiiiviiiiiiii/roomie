// Firestore security rules — LOCKED DOWN.
//
// All data access goes through the Roomie Express API using the Firebase
// Admin SDK (which bypasses these rules). Direct client reads/writes are
// denied everywhere, so a leaked web API key alone grants nothing.
//
// Deploy with:  firebase deploy --only firestore:rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
