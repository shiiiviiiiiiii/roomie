// Cloud Storage security rules — LOCKED DOWN.
//
// Uploads go through the Roomie Express API (multer → Admin SDK), which
// bypasses these rules. Listing photos are made public object-by-object by
// the server, so direct client SDK access stays denied everywhere.
//
// Deploy with:  firebase deploy --only storage
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
