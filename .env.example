# --- Server ---
PORT=4000
# Set to production when deployed; keeps error responses generic and
# enables production-only hardening.
NODE_ENV=development

# Firebase Admin SDK credentials — pick ONE of the two options below.
#
# Option A: individual fields (good for env-var-only hosts like Railway/Render).
# The private key is the "private_key" value from the service-account JSON.
# Keep the literal \n sequences — the server converts them to real newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Bucket name; defaults to <project-id>.appspot.com when unset.
# FIREBASE_STORAGE_BUCKET=

# Option B: path to a service-account JSON key file (good for Docker / VMs).
# Mount the file into the container and point here; never commit the file.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/roomie-service-account.json

# Comma-separated list of origins allowed to call the API from a browser.
# Add your production domain(s) here, e.g. https://roomie.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# --- Local Firebase Emulator Suite (dev / seed / verification) ---
# Point the server at the emulators instead of a real project:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Client (Vite) ---
# Firebase web app config — copy from the Firebase console
# (Project settings → Your apps → Web app). Baked in at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to point the web app at the local Auth emulator.
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# --- STUBBED integrations (all optional; features return clear stubs until set) ---
# Phone / OTP login (Twilio or MSG91) — still stubbed, not implemented.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_API_KEY=
# Transactional email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
